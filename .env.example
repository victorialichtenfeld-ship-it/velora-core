# Optional. The site runs without secrets. Payments need Stripe.

NEXT_PUBLIC_SITE_URL=http://127.0.0.1:4317

# Stripe (required to charge cards). Test keys first. A free *.vercel.app URL is enough — no paid domain.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
# Allow opening a workspace after checkout when Stripe is not connected (local only).
ALLOW_OFFLINE_CHECKOUT=

# LLM explanations (otherwise Velora uses deterministic copy)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Customer validation
GOOGLE_SHEETS_WEBHOOK_URL=
VALIDATION_INBOX_KEY=
